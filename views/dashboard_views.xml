<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vue Liste pour les statistiques par niveau -->
        <record id="view_dashboard_level_stats_tree" model="ir.ui.view">
            <field name="name">silina.dashboard.level.stats.list</field>
            <field name="model">silina.dashboard.level.stats</field>
            <field name="arch" type="xml">
                <list string="Statistiques par Niveau" create="false" edit="false" delete="false">
                    <field name="level_id"/>
                    <field name="total_students" sum="Total"/>
                    <field name="male_students" sum="Total Garçons"/>
                    <field name="female_students" sum="Total Filles"/>
                </list>
            </field>
        </record>

        <!-- Vue Liste pour les statistiques par classe -->
        <record id="view_dashboard_classroom_stats_tree" model="ir.ui.view">
            <field name="name">silina.dashboard.classroom.stats.list</field>
            <field name="model">silina.dashboard.classroom.stats</field>
            <field name="arch" type="xml">
                <list string="Statistiques par Classe" create="false" edit="false" delete="false">
                    <field name="classroom_id"/>
                    <field name="total_students"/>
                    <field name="male_students"/>
                    <field name="female_students"/>
                </list>
            </field>
        </record>

        <!-- Vue Formulaire du Tableau de Bord -->
        <record id="view_dashboard_form" model="ir.ui.view">
            <field name="name">silina.dashboard.form</field>
            <field name="model">silina.dashboard</field>
            <field name="arch" type="xml">
                <form string="Tableau de Bord" create="false" edit="false" delete="false">
                    <header>
                        <button name="action_refresh" string="Actualiser" type="object" class="btn-primary"
                                groups="silina_edu.group_silina_edu_coordinator"/>
                        <field name="current_academic_year_id" widget="selection" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <i class="fa fa-dashboard"/> Tableau de Bord Scolaire
                            </h1>
                        </div>

                        <!-- Statistiques des Élèves -->
                        <group string="📊 Statistiques des Élèves">
                            <group>
                                <field name="total_students" widget="statinfo" string="Total Élèves"/>
                                <field name="enrolled_students" widget="statinfo" string="Inscrits"/>
                            </group>
                            <group>
                                <field name="male_students" widget="statinfo" string="Garçons"/>
                                <field name="female_students" widget="statinfo" string="Filles"/>
                            </group>
                        </group>

                        <separator/>

                        <!-- Statistiques Financières -->
                        <group string="💰 Statistiques Financières">
                            <group>
                                <field name="total_expected_amount" widget="monetary"/>
                                <field name="total_paid_amount" widget="monetary"/>
                                <field name="total_debt_amount" widget="monetary" class="text-danger"/>
                            </group>
                            <group>
                                <field name="payment_rate" widget="percentage"/>
                                <field name="total_students_with_debt" widget="statinfo" string="Élèves Débiteurs"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>

                        <separator/>

                        <!-- Statistiques du Personnel -->
                        <group string="👥 Statistiques du Personnel">
                            <group>
                                <field name="total_teachers" widget="statinfo" string="Enseignants"/>
                                <field name="total_employees" widget="statinfo" string="Employés"/>
                            </group>
                            <group>
                                <field name="total_departments" widget="statinfo" string="Départements"/>
                            </group>
                        </group>

                        <separator/>

                        <!-- Trésorerie -->
                        <group string="🏦 Trésorerie">
                            <field name="cash_balance" widget="monetary" class="oe_subtotal_footer_separator" style="font-size: 18px; font-weight: bold;"/>
                        </group>

                        <separator/>

                        <!-- Statistiques par Niveau -->
                        <notebook>
                            <page string="Par Niveau" name="by_level">
                                <field name="stats_by_level_ids" nolabel="1" context="{'tree_view_ref': 'silina_edu.view_dashboard_level_stats_tree'}">
                                    <list string="Statistiques par Niveau" create="false" edit="false" delete="false">
                                        <field name="level_id"/>
                                        <field name="total_students" sum="Total"/>
                                        <field name="male_students" sum="Total Garçons"/>
                                        <field name="female_students" sum="Total Filles"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Statistiques par Classe -->
                            <page string="Par Classe" name="by_classroom">
                                <field name="stats_by_classroom_ids" nolabel="1" context="{'tree_view_ref': 'silina_edu.view_dashboard_classroom_stats_tree'}">
                                    <list string="Statistiques par Classe" create="false" edit="false" delete="false">
                                        <field name="classroom_id"/>
                                        <field name="total_students"/>
                                        <field name="male_students"/>
                                        <field name="female_students"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action du Tableau de Bord -->
        <record id="action_dashboard" model="ir.actions.server">
            <field name="name">Tableau de Bord</field>
            <field name="model_id" ref="model_silina_dashboard"/>
            <field name="state">code</field>
            <field name="code">
dashboard = model.get_dashboard()
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'silina.dashboard',
    'view_mode': 'form',
    'res_id': dashboard.id,
    'target': 'current',
}
            </field>
        </record>

    </data>
</odoo>
