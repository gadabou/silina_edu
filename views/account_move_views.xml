<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Recherche : filtrer les factures de frais et grouper par année -->
        <record id="view_account_move_search_silina" model="ir.ui.view">
            <field name="name">account.move.search.silina</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <separator/>
                    <filter name="filter_silina_fee"
                            string="Frais scolaires"
                            domain="[('is_silina_fee', '=', True)]"/>
                    <field name="silina_student_id"/>
                    <field name="silina_academic_year_id"/>
                    <group expand="0" string="Regrouper par">
                        <filter name="group_by_silina_year"
                                string="Année scolaire"
                                context="{'group_by': 'silina_academic_year_id'}"/>
                        <filter name="group_by_silina_student"
                                string="Élève (SILINA)"
                                context="{'group_by': 'silina_student_id'}"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Liste : colonnes année scolaire et élève -->
        <record id="view_account_move_tree_silina" model="ir.ui.view">
            <field name="name">account.move.list.silina</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="silina_academic_year_id" optional="show"/>
                    <field name="silina_student_id" optional="hide"/>
                </field>
            </field>
        </record>

        <!-- Formulaire : rattachement SILINA visible sur les factures de frais -->
        <record id="view_account_move_form_silina" model="ir.ui.view">
            <field name="name">account.move.form.silina</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="invoice_date_due" position="after">
                    <field name="silina_academic_year_id"
                           invisible="not silina_student_id" readonly="1"/>
                    <field name="silina_student_id"
                           invisible="not silina_student_id" readonly="1"/>
                    <field name="silina_fee_type_id"
                           invisible="not silina_student_id" readonly="1"/>
                    <field name="is_silina_fee" invisible="1"/>
                </field>
            </field>
        </record>

        <!-- Action dédiée : factures de frais scolaires groupées par année -->
        <record id="action_silina_fee_invoices" model="ir.actions.act_window">
            <field name="name">Factures de frais par année</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_silina_fee', '=', True)]</field>
            <field name="context">{
                'search_default_group_by_silina_year': 1,
                'default_move_type': 'out_invoice',
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aucune facture de frais scolaires pour le moment
                </p>
                <p>
                    Les factures générées via les assistants de frais apparaissent
                    ici, regroupées par année scolaire.
                </p>
            </field>
        </record>

    </data>
</odoo>
