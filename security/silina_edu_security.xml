        <!-- Catégories -->
        <record id="module_category_silina_edu" model="ir.module.category">
            <field name="name">SILINA-EDU</field>
            <field name="description">Gestion Scolaire</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groupes de sécurité -->
        <record id="group_silina_edu_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_silina_edu"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_silina_edu_teacher" model="res.groups">
            <field name="name">Enseignant</field>
            <field name="category_id" ref="module_category_silina_edu"/>
            <field name="implied_ids" eval="[(4, ref('group_silina_edu_user'))]"/>
        </record>

        <record id="group_silina_edu_coordinator" model="res.groups">
            <field name="name">Coordinateur</field>
            <field name="category_id" ref="module_category_silina_edu"/>
            <field name="implied_ids" eval="[(4, ref('group_silina_edu_teacher'))]"/>
        </record>

        <record id="group_silina_edu_manager" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="category_id" ref="module_category_silina_edu"/>
            <field name="implied_ids" eval="[(4, ref('group_silina_edu_coordinator'))]"/>
        </record>

        <!-- Un utilisateur interne N'EST PLUS automatiquement Administrateur SILINA-EDU.
             Suppression explicite de l'ancienne implication pour les bases déjà installées.
             (Les appartenances déjà existantes à group_silina_edu_manager sont conservées ;
             voir migrations/18.0.1.1.0/post-migration.py.) -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(3, ref('group_silina_edu_manager'))]"/>
        </record>

        <!-- Les administrateurs Odoo restent administrateurs SILINA-EDU -->
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('group_silina_edu_manager'))]"/>
        </record>

        <!-- ================================================================
             RÈGLES D'ENREGISTREMENT : périmètre de l'enseignant
             ================================================================
             Mécanique Odoo : les règles de groupe s'additionnent par OU entre
             elles pour un utilisateur ; les règles globales par ET. Les groupes
             impliqués vont vers le bas (manager => coordinateur => enseignant
             => utilisateur) : un coordinateur/manager hérite donc aussi de la
             règle « enseignant », mais la règle [(1,'=',1)] du groupe
             coordinateur l'élargit par OU => accès total. Un utilisateur
             uniquement « Enseignant » n'a que la règle restrictive.
             Le groupe « Utilisateur » n'a volontairement AUCUNE règle (une règle
             [(1,'=',1)] sur ce groupe annulerait la restriction de l'enseignant,
             car l'enseignant implique « Utilisateur »).

             Lien utilisateur -> enseignant :
               silina.teacher.user_id (= employee_id.user_id, stocké, cf.
               models/security_helpers.py)
             Périmètre « classes » d'un enseignant (domaine PATH_CLASSES) :
               classroom_id.subject_assignment_ids.teacher_id.user_id = user
               OU classroom_id.main_teacher_id.user_id = user  (titulaire)
             Périmètre « matière x classe » (silina.exam.result, silina.exam) :
               champ non stocké recherchable silina_teacher_scope, calculé à
               partir des affectations (classe, matière) de l'enseignant :
               (classe = affectée ET matière affectée) OU classe dont il est titulaire.
               Pour silina.exam : ou créé par l'utilisateur ; une classe concernée
               dans son périmètre (et matières de l'examen vides ou affectées) ;
               à défaut de classes, niveaux de ses classes.
        -->

        <!-- Élèves : lecture des élèves de ses classes.
             L'ancienne règle « utilisateur » [(1,'=',1)] est supprimée : elle
             rendait le périmètre de l'enseignant nul (OU). -->
        <record id="silina_student_rule_teacher" model="ir.rule">
            <field name="name">Élève: enseignant limité à ses classes</field>
            <field name="model_id" ref="model_silina_student"/>
            <field name="domain_force">['|', ('classroom_id.subject_assignment_ids.teacher_id.user_id', '=', user.id), ('classroom_id.main_teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_silina_edu_teacher'))]"/>
        </record>

        <record id="silina_student_rule_coordinator" model="ir.rule">
            <field name="name">Élève: tous droits pour coordinateur</field>
            <field name="model_id" ref="model_silina_student"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_silina_edu_coordinator'))]"/>
        </record>

