<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Format papier : A4 portrait (modèle papier du livret) -->
        <record id="paperformat_livret_a4_portrait" model="report.paperformat">
            <field name="name">Livret A4 portrait</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">8</field>
            <field name="margin_bottom">8</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>
        <!-- Ancien format paysage, remplacé par le portrait -->
        <delete model="report.paperformat" id="paperformat_livret_a4_landscape"/>

        <!--
            Rapport sur silina.student (comme le bulletin). Les données sont préparées par
            ReportLivret._build_livret_card (wizards/generate_report_card.py) ; le mode
            « competency » du cycle remplace les notes par un niveau court (AD/A/ECA/NA).
        -->
        <record id="action_report_livret" model="ir.actions.report">
            <field name="name">Livret scolaire (crèche/préscolaire/primaire)</field>
            <field name="model">silina.student</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">silina_edu.report_livret_document</field>
            <field name="report_file">silina_edu.report_livret_document</field>
            <field name="paperformat_id" ref="paperformat_livret_a4_portrait"/>
        </record>

        <template id="report_livret_styles">
                <style>
                    .lv-page { font-family: 'DejaVu Sans', Arial, sans-serif; font-size: 8pt; color: #111; }
                    .lv-page:last-child { page-break-after: auto; }
                    .lv-top { width: 100%; border-collapse: collapse; }
                    .lv-top td { padding: 0; vertical-align: bottom; }
                    .lv-title { font-size: 15pt; font-weight: bold; letter-spacing: 0.5px; }
                    .lv-year { font-size: 12pt; font-weight: bold; text-align: right; }
                    .lv-id { width: 100%; border-collapse: collapse; margin-top: 6px; }
                    .lv-id td { padding: 5px 0 0 0; vertical-align: bottom; font-style: italic; font-weight: bold; font-size: 10pt; }
                    .lv-id td.v { border-bottom: 1px dotted #000; font-style: normal; font-weight: normal; font-size: 9pt; padding-left: 4px; padding-right: 6px; }
                    .lv-comp { text-align: center; font-size: 13pt; font-weight: bold; margin: 8px 0 4px 0; letter-spacing: 0.5px; }
                    .lv-grid { width: 100%; border-collapse: collapse; table-layout: fixed; }
                    .lv-grid th, .lv-grid td { border: 1px solid #000; padding: 0 2px; text-align: center; font-size: 7.5pt; overflow: hidden; }
                    .lv-grid th { font-style: italic; font-size: 7pt; height: 30px; }
                    .lv-grid td { height: 21px; }
                    .lv-grid td.nm { text-align: left; font-weight: bold; font-size: 7.5pt; line-height: 1.05; }
                    .lv-grid td.nm.sub { font-size: 7pt; }
                    .lv-grid td.nm.long { font-size: 6pt; }
                    .lv-grid td.grp { padding: 0; position: relative; }
                    .lv-grid td.brace { border-left: none; border-right: none; border-top: none; border-bottom: none; padding: 0; text-align: center; overflow: hidden; }
                    .lv-grid tr.foot td { height: 22px; font-weight: bold; }
                    .lv-grid tr.foot td.nm { font-size: 10pt; text-align: center; }
                    .lv-grid td.no-left { border-left: none; }
                    .lv-rot { position: absolute; left: 0; width: 100%; }
                    .lv-block { width: 100%; border-collapse: collapse; margin-top: 8px; }
                    .lv-block td { vertical-align: top; padding: 0; }
                    .lv-h { font-style: italic; font-weight: bold; font-size: 10pt; padding: 6px 0 2px 0; }
                    .lv-ln { width: 100%; border-collapse: collapse; }
                    .lv-ln td { height: 17px; font-size: 7.5pt; vertical-align: bottom; padding: 0; }
                    .lv-ln td.lb { width: 20mm; white-space: nowrap; }
                    .lv-ln td.tx { border-bottom: 1px dotted #000; }
                    .lv-legend { font-size: 6.5pt; color: #555; margin-top: 2px; }
                </style>
        </template>

        <template id="report_livret_document">
            <t t-call="web.html_container">
                <t t-foreach="cards" t-as="c">
                    <div class="article">
                    <t t-call="silina_edu.report_livret_styles"/>
                    <div class="page lv-page">
                        <table class="lv-top">
                            <tr>
                                <td><span class="lv-title" t-out="c['title']"/></td>
                                <td class="lv-year">
                                    <t t-out="c['year_label']"/>
                                </td>
                            </tr>
                        </table>

                        <table class="lv-id">
                            <tr>
                                <td style="width: 14%;">École :</td>
                                <td class="v" colspan="3"><t t-out="company.name"/></td>
                            </tr>
                            <tr>
                                <td>Nom et prénoms :</td>
                                <td class="v" colspan="3"><t t-out="c['student'].name"/></td>
                            </tr>
                            <tr>
                                <td>Date d'entrée :</td>
                                <td class="v" style="width: 38%;"><t t-out="c['entry_date']"/></td>
                                <td style="width: 16%; text-align: right;">N° Matricule :</td>
                                <td class="v"><t t-out="c['student'].registration_number"/></td>
                            </tr>
                            <tr>
                                <td>Cours :</td>
                                <td class="v"><t t-out="c['classroom'].name"/></td>
                                <td style="text-align: right;">Effectif :</td>
                                <td class="v"><t t-out="c['effectif']"/></td>
                            </tr>
                        </table>

                        <div class="lv-comp">COMPOSITIONS</div>

                        <table class="lv-grid">
                            <colgroup>
                                <col style="width: 4%;"/>
                                <col style="width: 2.5%;"/>
                                <col style="width: 24%;"/>
                                <col t-foreach="c['month_nums']" t-as="n" t-att-style="'width: {0:.2f}'.format(55.8 / len(c['month_nums'])) + '%;'"/>
                                <col style="width: 6.7%;"/>
                                <col style="width: 7%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th colspan="3" style="text-align: left; font-size: 7.5pt;">DISCIPLINES</th>
                                    <th t-foreach="c['month_nums']" t-as="n">
                                        <t t-out="n"/><t t-if="n == 1">er</t><t t-else="">e</t><br/>MOIS
                                    </th>
                                    <th style="font-style: normal; font-size: 8pt;">Total</th>
                                    <th style="font-size: 5.5pt;">OBSER-<br/>VATIONS</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="c['rows']" t-as="r">
                                    <tr>
                                        <t t-if="r['group_start']">
                                            <td class="grp" t-att-rowspan="r['group_size']">
                                                <div t-att-style="'position: relative; width: 100%; height: ' + str(r['group_size'] * 22) + 'px; overflow: hidden;'">
                                                    <div t-att-style="'position: absolute; left: 5px; top: %dpx; width: %dpx; height: 16px; line-height: 16px; font-size: 6.5pt; font-weight: bold; text-align: center; -webkit-transform-origin: 0 0; -webkit-transform: rotate(-90deg); transform-origin: 0 0; transform: rotate(-90deg);' % (r['group_size'] * 22, r['group_size'] * 22)">
                                                        <t t-out="r['group']"/>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="brace" t-att-rowspan="r['group_size']"
                                                t-att-style="'font-size: %dpx; line-height: %dpx;' % (r['group_size'] * 20, r['group_size'] * 22)">{</td>
                                        </t>
                                        <t t-if="r['group']">
                                            <td t-att-class="'nm sub no-left' + (' long' if r['long'] else '')"><t t-out="r['name']"/></td>
                                        </t>
                                        <t t-else="">
                                            <td colspan="3" t-att-class="'nm' + (' long' if r['long'] else '')"><t t-out="r['name']"/></td>
                                        </t>
                                        <td t-foreach="r['cells']" t-as="v"><t t-out="v"/></td>
                                        <td><strong t-out="r['total']"/></td>
                                        <td/>
                                    </tr>
                                </t>
                                <tr class="foot">
                                    <td colspan="3" class="nm">Total</td>
                                    <td t-foreach="c['total_cells']" t-as="v"><t t-out="v"/></td>
                                    <td t-out="c['total_sum']"/>
                                    <td/>
                                </tr>
                                <tr class="foot">
                                    <td colspan="3" class="nm">Moyenne</td>
                                    <td t-foreach="c['average_cells']" t-as="v"><t t-out="v"/></td>
                                    <td t-out="c['average_total']"/>
                                    <td/>
                                </tr>
                                <tr class="foot">
                                    <td colspan="3" class="nm">Rang</td>
                                    <td t-foreach="c['rank_cells']" t-as="v"><t t-out="v"/></td>
                                    <td/>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="c['competency']" class="lv-legend">
                            Niveaux :
                            <t t-foreach="levels" t-as="lvl">
                                <strong t-out="lvl[0]"/> = <t t-out="lvl[1]"/><t t-if="not lvl_last"> ; </t>
                            </t>
                        </div>

                        <table class="lv-block">
                            <tr>
                                <td style="width: 50%; padding-right: 14px;">
                                    <div class="lv-h">Appréciation du maître :</div>
                                    <table class="lv-ln">
                                        <tr t-foreach="[('1er', 0), ('2e', 1), ('3e', 2)]" t-as="t">
                                            <td class="lb"><t t-out="t[0]"/> trimestre :</td>
                                            <td class="tx"><t t-out="c['terms'][t[1]]['teacher']"/></td>
                                        </tr>
                                    </table>
                                    <div class="lv-h" style="padding-top: 10px;">Signature du parent :</div>
                                    <table class="lv-ln">
                                        <tr t-foreach="['1er', '2e', '3e']" t-as="t">
                                            <td class="lb"><t t-out="t"/> trimestre :</td>
                                            <td class="tx"/>
                                        </tr>
                                    </table>
                                </td>
                                <td style="width: 50%; padding-left: 14px;">
                                    <div class="lv-h" style="padding-top: 24px;">Appréciation générale du Directeur</div>
                                    <table class="lv-ln">
                                        <tr t-foreach="[('1er', 0), ('2e', 1), ('3e', 2)]" t-as="t">
                                            <td class="lb"><t t-out="t[0]"/> trimestre :</td>
                                            <td class="tx"><t t-out="c['terms'][t[1]]['director']"/></td>
                                        </tr>
                                        <tr><td class="lb"/><td class="tx"/></tr>
                                        <tr><td class="lb"/><td class="tx"/></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
